rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() { return request.auth != null; }
    function superAdmin() {
      return loggedIn() && request.auth.token.email == 'seat-26@school-22aa0.firebaseapp.com';
    }
    function accountPath() {
      return /databases/$(database)/documents/accounts/$(request.auth.uid);
    }
    function activeAccount() {
      return loggedIn() && exists(accountPath())
        && get(accountPath()).data.email == request.auth.token.email
        && get(accountPath()).data.role in ['student','teacher','admin'];
    }
    function member() { return superAdmin() || activeAccount(); }
    function manager() {
      return superAdmin() || (activeAccount() && get(accountPath()).data.role in ['admin','teacher']);
    }
    function auditCheck() {
      return member()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }
    match /accounts/{uid} {
      allow read: if superAdmin() || (loggedIn() && request.auth.uid == uid);
      allow create: if superAdmin()
        && uid != request.auth.uid
        && request.resource.data.role in ['admin','teacher','student']
        && request.resource.data.seat is int
        && request.resource.data.seat >= 0 && request.resource.data.seat <= 99
        && request.resource.data.seat != 26
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','updatedBy','updatedAt'])
        && request.resource.data.role in ['admin','teacher','student']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /meta/{id} {
      allow read: if member();
      allow create, update: if manager() && id == 'settings'
        && request.resource.data.sharedCost is int
        && request.resource.data.sharedCost >= 0
        && request.resource.data.stallName is string
        && request.resource.data.stallName.size() <= 45;
      allow delete: if false;
    }
    match /promotions/{id} {
      allow read: if member();
      allow create: if manager()
        && request.resource.data.productA is string
        && request.resource.data.productB is string
        && request.resource.data.productA != request.resource.data.productB
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.price <= 10000000;
      allow update, delete: if false;
    }
    match /products/{id} {
      allow read: if member();
      allow create: if manager()
        && request.resource.data.sold == 0
        && request.resource.data.revenue == 0
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.recipe is list
        && request.resource.data.recipe.size() > 0
        && request.resource.data.recipe.size() <= 12
        && request.resource.data.addonOptions is list
        && request.resource.data.addonOptions.size() <= 12;
      allow update: if (superAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sold','revenue','lastResetBy','lastResetAt'
          ])
          && request.resource.data.sold == 0
          && request.resource.data.revenue == 0
          && request.resource.data.lastResetBy == request.auth.uid
          && request.resource.data.lastResetAt == request.time)
        || (manager()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name','category','unit','price','recipe','addonOptions','hidden','updatedAt'
          ])
          && request.resource.data.price is int
          && request.resource.data.price > 0
          && request.resource.data.category in ['飯捲','冰淇淋'])
        || (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sold','revenue','lastOrderId','updatedAt'
          ])
          && request.resource.data.sold is int
          && request.resource.data.sold > resource.data.sold
          && request.resource.data.revenue is int
          && request.resource.data.revenue >= resource.data.revenue
          && existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId))
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.actorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.status == 'valid')
        || (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'sold','revenue','lastRefundId','updatedAt'
          ])
          && request.resource.data.sold is int && request.resource.data.sold >= 0
          && request.resource.data.sold < resource.data.sold
          && request.resource.data.revenue is int && request.resource.data.revenue >= 0
          && request.resource.data.revenue <= resource.data.revenue
          && existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId))
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.status == 'voided'
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.refundedByUid == request.auth.uid);
      allow delete: if false;
    }
    match /ingredients/{id} {
      allow read: if member();
      allow create: if manager()
        && request.resource.data.name is string
        && request.resource.data.unit is string
        && request.resource.data.totalQty is int
        && request.resource.data.totalQty >= 0
        && request.resource.data.totalQty <= 10000000
        && request.resource.data.unitCost is int
        && request.resource.data.unitCost >= 0
        && request.resource.data.unitCost <= 10000000
        && request.resource.data.usedQty == 0;
      allow update: if (superAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedQty','lastResetBy','lastResetAt'
          ])
          && request.resource.data.usedQty == 0
          && request.resource.data.lastResetBy == request.auth.uid
          && request.resource.data.lastResetAt == request.time)
        || (manager()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','unit','totalQty','unitCost','updatedAt'
          ])
          && request.resource.data.totalQty is int
          && request.resource.data.totalQty >= resource.data.usedQty
          && request.resource.data.totalQty <= 10000000)
        || (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedQty','lastOrderId','updatedAt'
          ])
          && request.resource.data.usedQty is int
          && request.resource.data.usedQty > resource.data.usedQty
          && request.resource.data.usedQty <= resource.data.totalQty
          && existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId))
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.actorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.needs[id] == request.resource.data.usedQty - resource.data.usedQty)
        || (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedQty','lastRefundId','updatedAt'
          ])
          && request.resource.data.usedQty is int
          && request.resource.data.usedQty >= 0
          && request.resource.data.usedQty < resource.data.usedQty
          && existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId))
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.refundedByUid == request.auth.uid
          && (
            (('needs' in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data)
              && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.needs[id] == resource.data.usedQty - request.resource.data.usedQty)
            || (('usedIngredients' in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data)
              && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.usedIngredients[id] == resource.data.usedQty - request.resource.data.usedQty)
          ));
      allow delete: if false;
    }
    match /sales/{id} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.status == 'valid'
        && request.resource.data.createdAt == request.time
        && request.resource.data.hidden == false
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 4
        && request.resource.data.needs is map
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.total <= 10000000
        && request.resource.data.paid is int
        && request.resource.data.paid >= request.resource.data.total
        && request.resource.data.change == request.resource.data.paid - request.resource.data.total;
      allow update: if (superAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','refundReason','refundedByUid','refundedAt',
            'hidden','hiddenBy','hiddenAt'
          ])
          && request.resource.data.status == 'voided'
          && request.resource.data.refundReason == '26 號清空測試資料'
          && request.resource.data.refundedByUid == request.auth.uid
          && request.resource.data.refundedAt == request.time
          && request.resource.data.hidden == true
          && request.resource.data.hiddenBy == request.auth.uid
          && request.resource.data.hiddenAt == request.time)
        || (member()
          && resource.data.status == 'valid'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','refundReason','refundedByUid','refundedAt'
          ])
          && request.resource.data.status == 'voided'
          && request.resource.data.refundedByUid == request.auth.uid
          && request.resource.data.refundedAt == request.time
          && request.resource.data.refundReason is string
          && request.resource.data.refundReason.size() > 0
          && request.resource.data.refundReason.size() <= 150)
        || (superAdmin()
          && resource.data.status == 'voided'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hidden','hiddenBy','hiddenAt'
          ])
          && request.resource.data.hidden == true
          && request.resource.data.hiddenBy == request.auth.uid
          && request.resource.data.hiddenAt == request.time);
      allow delete: if false;
    }
    match /audit/{id} {
      allow read: if manager();
      allow create: if auditCheck()
        && request.resource.data.hidden == false
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 300;
      allow update: if superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hidden','hiddenBy','hiddenAt'
        ])
        && request.resource.data.hidden == true
        && request.resource.data.hiddenBy == request.auth.uid
        && request.resource.data.hiddenAt == request.time;
      allow delete: if false;
    }
  }
}
