rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // School Anniversary 全新專案：帳號存於 accounts/{座號}；密碼證明不對客戶端開放讀取。
    // Firebase Anonymous Auth 只提供不可偽造的裝置 UID；座號權限由此處的 Firestore 工作階段核對。
    function accountPath(seat) { return /databases/$(database)/documents/accounts/$(seat); }
    function secretPath(seat) { return /databases/$(database)/documents/loginSecrets/$(seat); }
    function sessionPath() { return /databases/$(database)/documents/sessions/$(request.auth.uid); }
    function hasSession() {
      return request.auth != null
        && exists(sessionPath())
        && get(sessionPath()).data.issuedAt > request.time - duration.value(15,'d')
        && exists(accountPath(get(sessionPath()).data.seat))
        && get(accountPath(get(sessionPath()).data.seat)).data.enabled == true
        && get(accountPath(get(sessionPath()).data.seat)).data.credentialVersion == get(sessionPath()).data.version;
    }
    function member() { return hasSession(); }
    function role() { return get(accountPath(get(sessionPath()).data.seat)).data.role; }
    function superAdmin() {
      return member() && get(sessionPath()).data.seat == '26' && role() == 'super';
    }
    function manager() { return member() && (superAdmin() || role() in ['admin','teacher']); }
    function catalogAdmin() { return member() && (superAdmin() || role() == 'admin'); }

    match /accounts/{seat} {
      // 一次性首個管理員啟用：不允許修改角色、密碼版本或覆寫已建立的 26 號。
      // 僅能按座號單筆讀取帳號基本資訊；密碼證明獨立存在 loginSecrets，不可讀取。
      allow get: if request.auth != null;
      allow list: if superAdmin();
      allow create: if request.auth != null && (
        (seat == '26' && !exists(accountPath('26'))
         && request.resource.data.keys().hasOnly(['seat','role','name','enabled','credentialVersion','createdAt'])
         && request.resource.data.seat == '26' && request.resource.data.role == 'super'
         && request.resource.data.name == '最高管理員' && request.resource.data.enabled == true
         && request.resource.data.credentialVersion == 1 && request.resource.data.createdAt == request.time
         && getAfter(secretPath('26')).data.proof == '3a090e43c45470a767c3ad161f46e85b04de2503b03b5878eee71e1e2007ee75')
        || (superAdmin() && seat != '26' && seat.matches('^(00|[0-9]|[1-9][0-9])$')
         && request.resource.data.keys().hasOnly(['seat','role','name','enabled','credentialVersion','createdAt'])
         && request.resource.data.seat == seat
         && request.resource.data.role in ['student','teacher','admin']
         && request.resource.data.name is string && request.resource.data.name.size() <= 30
         && request.resource.data.enabled == true && request.resource.data.credentialVersion == 1
         && request.resource.data.createdAt == request.time)
      );
      allow update: if superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'role','name','enabled','credentialVersion','updatedBy','updatedAt'])
        && request.resource.data.seat == resource.data.seat
        && request.resource.data.role == (seat == '26' ? 'super' : request.resource.data.role)
        && (seat == '26' || request.resource.data.role in ['student','teacher','admin'])
        && request.resource.data.credentialVersion is int
        && request.resource.data.credentialVersion >= resource.data.credentialVersion
        && request.resource.data.credentialVersion <= resource.data.credentialVersion + 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if superAdmin() && seat != '26';
    }

    match /loginSecrets/{seat} {
      allow read: if false;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['proof','updatedAt'])
        && request.resource.data.proof is string && request.resource.data.proof.matches('^[0-9a-f]{64}$')
        && request.resource.data.updatedAt == request.time
        && ((seat == '26' && !exists(accountPath('26'))
             && request.resource.data.proof == '3a090e43c45470a767c3ad161f46e85b04de2503b03b5878eee71e1e2007ee75'
             && getAfter(accountPath('26')).data.role == 'super')
            || (superAdmin() && seat != '26'));
      allow update: if superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proof','updatedAt'])
        && request.resource.data.proof is string && request.resource.data.proof.matches('^[0-9a-f]{64}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if superAdmin() && seat != '26';
    }

    match /sessions/{uid} {
      allow get: if request.auth != null && uid == request.auth.uid;
      allow list: if false;
      allow create, update: if request.auth != null && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['seat','proof','version','issuedAt'])
        && request.resource.data.seat is string
        && exists(accountPath(request.resource.data.seat))
        && get(accountPath(request.resource.data.seat)).data.enabled == true
        && request.resource.data.version == get(accountPath(request.resource.data.seat)).data.credentialVersion
        && request.resource.data.proof == get(secretPath(request.resource.data.seat)).data.proof
        && request.resource.data.issuedAt == request.time;
      allow delete: if request.auth != null && uid == request.auth.uid;
    }

    match /menuPublic/{id} {
      allow read: if true;
      allow create, update: if manager()
        && request.resource.data.keys().hasOnly(['name','category','unit','price','hidden','addons','publishedAt'])
        && request.resource.data.keys().hasAll(['name','category','unit','price','hidden','publishedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.category is string && request.resource.data.unit is string
        && request.resource.data.price is int && request.resource.data.price >= 1
        && request.resource.data.hidden is bool
        && request.resource.data.publishedAt == request.time
        && (!('addons' in request.resource.data) || request.resource.data.addons is list);
      allow delete: if catalogAdmin();
    }
    match /customerOrders/{id} { allow read, write: if false; }

    match /meta/{id} {
      allow read: if member();
      allow create, update: if manager() && id == 'settings'
        && request.resource.data.sharedCost is int && request.resource.data.sharedCost >= 0
        && request.resource.data.stallName is string && request.resource.data.stallName.size() <= 45;
      allow delete: if false;
    }
    match /promotions/{id} {
      allow read: if member();
      allow create: if manager()
        && request.resource.data.productA is string && request.resource.data.productB is string
        && request.resource.data.productA != request.resource.data.productB
        && request.resource.data.price is int && request.resource.data.price >= 0
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /products/{id} {
      allow read: if member();
      allow create: if manager()
        && request.resource.data.price is int && request.resource.data.price >= 1
        && request.resource.data.sold == 0 && request.resource.data.revenue == 0
        && request.resource.data.manualStock == 0
        && request.resource.data.unitCost is int && request.resource.data.unitCost >= 0
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.category in ['飯捲','冰淇淋','冰品']
        && request.resource.data.recipe is list
        && request.resource.data.addonOptions is list
        && request.resource.data.rollAddonOptions is list;
      allow update: if
        (manager()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'name','category','unit','price','unitCost','recipe','addonOptions','rollAddonOptions','hidden','updatedAt'])
         && request.resource.data.price is int && request.resource.data.price >= 1
         && request.resource.data.category in ['飯捲','冰淇淋','冰品'])
        || (superAdmin()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold','revenue','lastResetBy','lastResetAt'])
         && request.resource.data.sold == 0 && request.resource.data.revenue == 0
         && request.resource.data.lastResetBy == request.auth.uid && request.resource.data.lastResetAt == request.time)
        || (manager()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['manualStock','lastStockAuditId','updatedAt'])
         && request.resource.data.manualStock is int && request.resource.data.manualStock >= 0
         && request.resource.data.updatedAt == request.time)
        || (member()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold','revenue','manualStock','lastOrderId','updatedAt'])
         && request.resource.data.updatedAt == request.time
         && request.resource.data.sold is int
         && request.resource.data.sold > resource.data.get('sold',0)
         && request.resource.data.revenue is int
         && request.resource.data.revenue >= resource.data.get('revenue',0)
         && request.resource.data.lastOrderId is string
         && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.actorUid == request.auth.uid
         && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.productDeltas[id].sold == request.resource.data.sold - resource.data.get('sold',0)
         && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.productDeltas[id].revenue == request.resource.data.revenue - resource.data.get('revenue',0)
         && (resource.data.category in ['飯捲','飯卷','飯糰']
              ? request.resource.data.manualStock >= 0
                && resource.data.get('manualStock',0) - request.resource.data.manualStock == getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.productDeltas[id].rollQty
              : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['manualStock'])))
        || (member()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold','revenue','manualStock','lastRefundId','updatedAt'])
         && request.resource.data.updatedAt == request.time
         && request.resource.data.sold is int && request.resource.data.sold >= 0
         && request.resource.data.sold < resource.data.get('sold',0)
         && request.resource.data.revenue is int && request.resource.data.revenue >= 0
         && request.resource.data.revenue <= resource.data.get('revenue',0)
         && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.status == 'voided'
         && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.refundedByUid == request.auth.uid);
      allow delete: if catalogAdmin() && resource.data.get('sold',0) == 0;
    }

    match /ingredients/{id} {
      allow read: if member();
      allow create: if manager()
        && request.resource.data.name is string && request.resource.data.unit is string
        && request.resource.data.totalQty is int && request.resource.data.totalQty >= 0
        && request.resource.data.unitCost is int && request.resource.data.unitCost >= 0
        && request.resource.data.usedQty == 0;
      allow update: if
        (manager()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','unit','totalQty','unitCost','updatedAt'])
         && request.resource.data.totalQty >= resource.data.get('usedQty',0))
        || (manager()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalQty','lastStockAuditId','updatedAt'])
         && request.resource.data.totalQty is int
         && request.resource.data.totalQty >= resource.data.totalQty)
        || (superAdmin()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedQty','lastResetBy','lastResetAt'])
         && request.resource.data.usedQty == resource.data.get('damagedQty',0)
         && request.resource.data.lastResetBy == request.auth.uid && request.resource.data.lastResetAt == request.time)
        || (member()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedQty','lastOrderId','updatedAt'])
         && request.resource.data.updatedAt == request.time
         && request.resource.data.usedQty is int
         && request.resource.data.usedQty > resource.data.get('usedQty',0)
         && request.resource.data.usedQty <= resource.data.totalQty
         && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.actorUid == request.auth.uid
         && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.needs[id] == request.resource.data.usedQty - resource.data.get('usedQty',0))
        || (member()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedQty','damagedQty','lastDamageId','updatedAt'])
         && request.resource.data.updatedAt == request.time
         && request.resource.data.usedQty is int && request.resource.data.usedQty <= resource.data.totalQty
         && request.resource.data.usedQty > resource.data.get('usedQty',0)
         && request.resource.data.damagedQty == resource.data.get('damagedQty',0) + request.resource.data.usedQty - resource.data.get('usedQty',0)
         && getAfter(/databases/$(database)/documents/damage/$(request.resource.data.lastDamageId)).data.actorUid == request.auth.uid)
        || (member()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedQty','lastRefundId','updatedAt'])
         && request.resource.data.updatedAt == request.time
         && request.resource.data.usedQty is int && request.resource.data.usedQty >= 0
         && request.resource.data.usedQty < resource.data.get('usedQty',0)
         && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.status == 'voided'
         && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.refundedByUid == request.auth.uid);
      allow delete: if catalogAdmin() && resource.data.get('usedQty',0) == 0 && resource.data.get('damagedQty',0) == 0;
    }

    match /rollIngredients/{id} {
      allow read: if member();
      allow create, update: if manager()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.unit is string
        && request.resource.data.defaultPrice is int && request.resource.data.defaultPrice >= 0
        && request.resource.data.unitCost is int && request.resource.data.unitCost >= 0;
      allow delete: if catalogAdmin();
    }
    match /damage/{id} {
      allow read: if member();
      allow create: if member() && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.qty is int && request.resource.data.qty >= 1
        && request.resource.data.ingredientId is string && request.resource.data.cost is int;
      allow update, delete: if false;
    }
    match /orderCounters/{day} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.date == day && request.resource.data.lastNo == 1
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.actorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.orderNo == request.resource.data.lastOrderNo;
      allow update: if member()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastNo','lastOrderId','lastOrderNo','updatedAt'])
        && request.resource.data.date == day
        && request.resource.data.lastNo is int
        && request.resource.data.lastNo == resource.data.lastNo + 1
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.actorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data.orderNo == request.resource.data.lastOrderNo;
      allow delete: if false;
    }
    match /cashCounts/{id} {
      allow read: if member();
      allow create: if member() && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.countedCash is int && request.resource.data.expectedCash is int
        && request.resource.data.variance == request.resource.data.countedCash - request.resource.data.expectedCash;
      allow update, delete: if false;
    }

    match /sales/{id} {
      function extraAmount(extras, i) { return i < extras.size() ? extras[i].qty * extras[i].price : 0; }
      function validExtra(extras, i) {
        return i >= extras.size() || (extras[i].id is string && extras[i].qty is int
          && extras[i].qty >= 1 && extras[i].price is int && extras[i].price >= 0
          && extras[i].netAmount is int && extras[i].netAmount >= 0
          && extras[i].netAmount <= extras[i].price * extras[i].qty);
      }
      function validExtras(extras) {
        return extras is list && extras.size() <= 12
          && validExtra(extras,0) && validExtra(extras,1) && validExtra(extras,2)
          && validExtra(extras,3) && validExtra(extras,4) && validExtra(extras,5)
          && validExtra(extras,6) && validExtra(extras,7) && validExtra(extras,8)
          && validExtra(extras,9) && validExtra(extras,10) && validExtra(extras,11);
      }
      function extrasSum(e) {
        return extraAmount(e,0)+extraAmount(e,1)+extraAmount(e,2)+extraAmount(e,3)
          +extraAmount(e,4)+extraAmount(e,5)+extraAmount(e,6)+extraAmount(e,7)
          +extraAmount(e,8)+extraAmount(e,9)+extraAmount(e,10)+extraAmount(e,11);
      }
      function validLine(l) {
        return l.productId is string && l.price is int && l.price >= 0
          && l.qty is int && l.qty >= 1 && l.qty <= 10000
          && l.gross == l.qty * l.price
          && validExtras(l.extras) && l.addonTotal == extrasSum(l.extras)
          && l.promoDiscount is int && l.promoDiscount >= 0
          && l.manualDiscount is int && l.manualDiscount >= 0
          && l.discount == l.promoDiscount + l.manualDiscount
          && l.lineTotal == l.gross + l.addonTotal - l.discount
          && l.lineTotal >= 0
          && (l.productId == '__manual_other__'
             ? (l.qty == 1 && l.category == '其它' && l.reason is string && l.reason.size() > 0)
             : (get(/databases/$(database)/documents/products/$(l.productId)).data.price == l.price
                && get(/databases/$(database)/documents/products/$(l.productId)).data.name == l.name
                && get(/databases/$(database)/documents/products/$(l.productId)).data.category == l.category
                && get(/databases/$(database)/documents/products/$(l.productId)).data.get('hidden',false) != true));
      }
      function lineValidAt(lines,i) { return i >= lines.size() || validLine(lines[i]); }
      function lineNet(lines,i) { return i < lines.size() ? lines[i].lineTotal : 0; }
      function lineBase(lines,i) { return i < lines.size() ? lines[i].gross + lines[i].addonTotal - lines[i].promoDiscount : 0; }
      function lineManual(lines,i) { return i < lines.size() ? lines[i].manualDiscount : 0; }
      function linePromo(lines,i) { return i < lines.size() ? lines[i].promoDiscount : 0; }
      function totalNet(lines) { return lineNet(lines,0)
           +lineNet(lines,1)
           +lineNet(lines,2)
           +lineNet(lines,3)
           +lineNet(lines,4)
           +lineNet(lines,5)
           +lineNet(lines,6)
           +lineNet(lines,7)
           +lineNet(lines,8)
           +lineNet(lines,9)
           +lineNet(lines,10)
           +lineNet(lines,11); }
      function totalBase(lines) { return lineBase(lines,0)
           +lineBase(lines,1)
           +lineBase(lines,2)
           +lineBase(lines,3)
           +lineBase(lines,4)
           +lineBase(lines,5)
           +lineBase(lines,6)
           +lineBase(lines,7)
           +lineBase(lines,8)
           +lineBase(lines,9)
           +lineBase(lines,10)
           +lineBase(lines,11); }
      function totalManual(lines) { return lineManual(lines,0)
           +lineManual(lines,1)
           +lineManual(lines,2)
           +lineManual(lines,3)
           +lineManual(lines,4)
           +lineManual(lines,5)
           +lineManual(lines,6)
           +lineManual(lines,7)
           +lineManual(lines,8)
           +lineManual(lines,9)
           +lineManual(lines,10)
           +lineManual(lines,11); }
      function totalPromo(lines) { return linePromo(lines,0)
           +linePromo(lines,1)
           +linePromo(lines,2)
           +linePromo(lines,3)
           +linePromo(lines,4)
           +linePromo(lines,5)
           +linePromo(lines,6)
           +linePromo(lines,7)
           +linePromo(lines,8)
           +linePromo(lines,9)
           +linePromo(lines,10)
           +linePromo(lines,11); }
      allow read: if member();
      allow create: if member()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.status == 'valid' && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0 && request.resource.data.lines.size() <= 12
        && request.resource.data.needs is map
        && request.resource.data.rollNeeds is map
        && request.resource.data.productDeltas is map
        && request.resource.data.manualDiscount is int && request.resource.data.manualDiscount >= 0
        && request.resource.data.promoDiscount is int && request.resource.data.promoDiscount >= 0
        && request.resource.data.baseTotal is int
        && request.resource.data.total is int && request.resource.data.total >= 0
        && request.resource.data.baseTotal == totalBase(request.resource.data.lines)
        && request.resource.data.manualDiscount == totalManual(request.resource.data.lines)
        && request.resource.data.promoDiscount == totalPromo(request.resource.data.lines)
        && request.resource.data.discount == request.resource.data.manualDiscount + request.resource.data.promoDiscount
        && request.resource.data.total == totalNet(request.resource.data.lines)
        && request.resource.data.total == request.resource.data.baseTotal - request.resource.data.manualDiscount
        && request.resource.data.manualReason is string
        && (request.resource.data.manualDiscount == 0 || request.resource.data.manualReason.size() > 0)
        && request.resource.data.paid is int && request.resource.data.paid >= request.resource.data.total
        && request.resource.data.change == request.resource.data.paid - request.resource.data.total
        && request.resource.data.orderNo is string
        && request.resource.data.orderNo.matches('^GD-[0-9]{8}-[0-9]{4,}$')
        && request.resource.data.orderSequence is int && request.resource.data.orderSequence >= 1
        && request.resource.data.fingerprint is string
        && lineValidAt(request.resource.data.lines,0)
        && lineValidAt(request.resource.data.lines,1)
        && lineValidAt(request.resource.data.lines,2)
        && lineValidAt(request.resource.data.lines,3)
        && lineValidAt(request.resource.data.lines,4)
        && lineValidAt(request.resource.data.lines,5)
        && lineValidAt(request.resource.data.lines,6)
        && lineValidAt(request.resource.data.lines,7)
        && lineValidAt(request.resource.data.lines,8)
        && lineValidAt(request.resource.data.lines,9)
        && lineValidAt(request.resource.data.lines,10)
        && lineValidAt(request.resource.data.lines,11);
      allow update: if (member()
        && resource.data.status == 'valid'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','refundReason','refundedByUid','refundedBySeat','refundedByName','refundedAt'])
        && request.resource.data.status == 'voided'
        && request.resource.data.refundedByUid == request.auth.uid
        && request.resource.data.refundedAt == request.time
        && request.resource.data.refundReason is string && request.resource.data.refundReason.size() > 0)
        || (superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','refundReason','refundedByUid','refundedBySeat','refundedByName','refundedAt','hidden','hiddenBy','hiddenAt'])
        && request.resource.data.status == 'voided'
        && request.resource.data.hidden == true
        && request.resource.data.refundedByUid == request.auth.uid
        && request.resource.data.refundedAt == request.time
        && request.resource.data.hiddenBy == request.auth.uid
        && request.resource.data.hiddenAt == request.time)
        || (superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden','hiddenBy','hiddenAt'])
        && request.resource.data.hidden == true
        && request.resource.data.hiddenBy == request.auth.uid
        && request.resource.data.hiddenAt == request.time);
      allow delete: if false;
    }
    match /audit/{id} {
      allow read: if manager();
      allow create: if member() && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 300
        && request.resource.data.hidden == false;
      allow update: if superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden','hiddenBy','hiddenAt'])
        && request.resource.data.hidden == true
        && request.resource.data.hiddenBy == request.auth.uid
        && request.resource.data.hiddenAt == request.time;
      allow delete: if false;
    }
  }
}
