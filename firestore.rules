rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() { return request.auth != null; }
    function superAdmin() {
      return loggedIn() && request.auth.token.email == 'seat-26@school-22aa0.firebaseapp.com';
    }
    function accountPath() {
      return /databases/$(database)/documents/accounts/$(request.auth.uid);
    }
    function activeAccount() {
      return loggedIn() && activeAccountDataValid();
    }
    // 相容舊帳號欄位；缺少資料時拒絕，不額外存取/修改文件。
    function activeAccountDataValid() {
      let account = get(accountPath()).data;
      return account.get('email', '') == request.auth.token.email
        && account.get('role', '') in ['student','teacher','admin'];
    }
    function member() { return superAdmin() || activeAccount(); }
    function manager() {
      return superAdmin() || (activeAccount() && get(accountPath()).data.role in ['admin','teacher']);
    }
    function auditCheck() {
      return member()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }
    match /accounts/{uid} {
      allow read: if superAdmin() || (loggedIn() && request.auth.uid == uid);
      allow create: if superAdmin()
        && uid != request.auth.uid
        && request.resource.data.role in ['admin','teacher','student']
        && request.resource.data.seat is int
        && request.resource.data.seat >= 0 && request.resource.data.seat <= 99
        && request.resource.data.seat != 26
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','updatedBy','updatedAt'])
        && request.resource.data.role in ['admin','teacher','student']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /meta/{id} {
      allow read: if member();
      allow create, update: if manager() && id == 'settings'
        && request.resource.data.sharedCost is int
        && request.resource.data.sharedCost >= 0
        && request.resource.data.stallName is string
        && request.resource.data.stallName.size() <= 45;
      allow delete: if false;
    }
    match /promotions/{id} {
      allow read: if member();
      allow create: if manager()
        && request.resource.data.productA is string
        && request.resource.data.productB is string
        && request.resource.data.productA != request.resource.data.productB
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.price <= 10000000;
      allow update, delete: if false;
    }
    // 只為待結帳名單提供最小權限：登入成員可讀，每人只能寫自己的在線狀態。
    // 不參與 sales、products、ingredients 或 orderCounters 的交易授權。
    match /checkoutPresence/{uid} {
      allow read: if member();
      allow create, update: if member() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','seat','name','active','updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.seat is int
        && request.resource.data.seat >= 0 && request.resource.data.seat <= 99
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if loggedIn() && uid == request.auth.uid;
    }
    match /products/{id} {
      allow read: if member();
      allow create: if manager()
        && request.resource.data.sold == 0
        && request.resource.data.revenue == 0
        && request.resource.data.price is int
        && request.resource.data.price >= 1
        && request.resource.data.price <= 10000000
        && request.resource.data.get('imageUrl', '') is string
        && request.resource.data.get('imageUrl', '').size() <= 1000
        && request.resource.data.manualStock == 0
        && request.resource.data.unitCost is int
        && request.resource.data.unitCost >= 0
        && request.resource.data.unitCost <= 10000000
        && request.resource.data.recipe is list
        && request.resource.data.addonOptions is list
        && request.resource.data.rollAddonOptions is list
        && request.resource.data.addonOptions.size() <= 12
        && request.resource.data.rollAddonOptions.size() <= 12
        && ((request.resource.data.category == '飯捲' && request.resource.data.recipe.size() == 0)
         || (request.resource.data.category == '冰淇淋'
           && request.resource.data.recipe.size() > 0
           && request.resource.data.recipe.size() <= 12
           && request.resource.data.rollAddonOptions.size() == 0));
      allow update: if (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sold','revenue','manualStock','lastOrderId','updatedAt'
          ])
          && request.resource.data.lastOrderId is string
          && request.resource.data.updatedAt == request.time
          && request.resource.data.sold is int
          && request.resource.data.sold > resource.data.get('sold', 0)
          && request.resource.data.revenue is int
          && request.resource.data.revenue >= resource.data.get('revenue', 0)
          && request.resource.data.revenue <= 10000000
          && ((resource.data.category in ['飯捲','飯卷','飯糰']
            && request.resource.data.manualStock is int
            && request.resource.data.manualStock >= 0
            && request.resource.data.manualStock <= resource.data.get('manualStock', 0))
           || (resource.data.category in ['冰淇淋','冰品']
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['manualStock']))))
        || (superAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sold','revenue','lastResetBy','lastResetAt'
          ])
          && request.resource.data.sold == 0
          && request.resource.data.revenue == 0
          && request.resource.data.lastResetBy == request.auth.uid
          && request.resource.data.lastResetAt == request.time)
        || (manager()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name','category','unit','price','unitCost','recipe','addonOptions','rollAddonOptions','imageUrl','hidden','updatedAt'
          ])
          && request.resource.data.get('imageUrl', '') is string
          && request.resource.data.get('imageUrl', '').size() <= 1000
          && request.resource.data.price is int
          && request.resource.data.price > 0
          && request.resource.data.category in ['飯捲','冰淇淋','冰品']
          && request.resource.data.unitCost is int
          && request.resource.data.unitCost >= 0
          && request.resource.data.recipe is list
          && request.resource.data.rollAddonOptions is list
          && ((request.resource.data.category == '飯捲' && request.resource.data.recipe.size() == 0)
           || (request.resource.data.category == '冰淇淋' && request.resource.data.recipe.size() > 0)))
        || (member()
          && resource.data.category in ['飯捲','飯卷','飯糰']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'manualStock','lastStockAuditId','updatedAt'
          ])
          && request.resource.data.manualStock is int
          && request.resource.data.manualStock >= 0
          && request.resource.data.manualStock <= 10000000
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastStockAuditId is string
          && getAfter(/databases/$(database)/documents/audit/$(request.resource.data.lastStockAuditId)).data.action == 'roll.stock.adjust'
          && getAfter(/databases/$(database)/documents/audit/$(request.resource.data.lastStockAuditId)).data.subjectId == id
          && getAfter(/databases/$(database)/documents/audit/$(request.resource.data.lastStockAuditId)).data.actorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/audit/$(request.resource.data.lastStockAuditId)).data.oldStock == resource.data.get('manualStock',0)
          && getAfter(/databases/$(database)/documents/audit/$(request.resource.data.lastStockAuditId)).data.newStock == request.resource.data.manualStock)
        || (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'sold','revenue','manualStock','lastRefundId','updatedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.sold is int
          && request.resource.data.sold >= 0
          && request.resource.data.sold < resource.data.get('sold', 0)
          && request.resource.data.revenue is int
          && request.resource.data.revenue >= 0
          && request.resource.data.revenue <= resource.data.get('revenue', 0)
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.status == 'voided'
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.refundedByUid == request.auth.uid
          && ((('productDeltas' in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data)
            && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.productDeltas[id].sold == resource.data.get('sold', 0) - request.resource.data.sold
            && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.productDeltas[id].revenue == resource.data.get('revenue', 0) - request.resource.data.revenue
            && ((resource.data.category in ['飯捲','飯卷','飯糰']
              && request.resource.data.get('manualStock',0) - resource.data.get('manualStock',0) == getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.productDeltas[id].rollQty)
             || !(resource.data.category in ['飯捲','飯卷','飯糰'])))
           || !('productDeltas' in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data)));
      allow delete: if false;
    }
    match /rollIngredients/{id} {
      allow read: if member();
      allow create: if manager()
        && request.resource.data.keys().hasOnly(['name','unit','defaultPrice','unitCost','hidden','createdAt','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0 && request.resource.data.unit.size() <= 12
        && request.resource.data.defaultPrice is int
        && request.resource.data.defaultPrice >= 0 && request.resource.data.defaultPrice <= 10000000
        && request.resource.data.unitCost is int
        && request.resource.data.unitCost >= 0 && request.resource.data.unitCost <= 10000000
        && request.resource.data.hidden is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if manager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','unit','defaultPrice','unitCost','hidden','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0 && request.resource.data.unit.size() <= 12
        && request.resource.data.defaultPrice is int
        && request.resource.data.defaultPrice >= 0 && request.resource.data.defaultPrice <= 10000000
        && request.resource.data.unitCost is int
        && request.resource.data.unitCost >= 0 && request.resource.data.unitCost <= 10000000
        && request.resource.data.hidden is bool
        && request.resource.data.updatedAt == request.time;
      // 僅 26 號可刪除誤建的飯捲加購原料；前端檢查配方及交易引用。
      allow delete: if superAdmin();
    }
    match /ingredients/{id} {
      allow read: if member();
      allow create: if manager()
        && request.resource.data.name is string
        && request.resource.data.unit is string
        && request.resource.data.totalQty is int
        && request.resource.data.totalQty >= 0
        && request.resource.data.totalQty <= 10000000
        && request.resource.data.unitCost is int
        && request.resource.data.unitCost >= 0
        && request.resource.data.unitCost <= 10000000
        && request.resource.data.usedQty == 0;
      allow update: if (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedQty','lastOrderId','updatedAt'
          ])
          && request.resource.data.lastOrderId is string
          && request.resource.data.updatedAt == request.time
          && request.resource.data.usedQty is int
          && request.resource.data.usedQty > resource.data.get('usedQty', 0)
          && request.resource.data.usedQty <= resource.data.totalQty)
        || (superAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedQty','lastResetBy','lastResetAt'
          ])
          && request.resource.data.usedQty == (('damagedQty' in resource.data) ? resource.data.damagedQty : 0)
          && request.resource.data.lastResetBy == request.auth.uid
          && request.resource.data.lastResetAt == request.time)
        || (manager()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','unit','totalQty','unitCost','updatedAt'
          ])
          && request.resource.data.totalQty is int
          && request.resource.data.totalQty >= resource.data.get('usedQty', 0)
          && request.resource.data.totalQty <= 10000000)
        || (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedQty','damagedQty','lastDamageId','updatedAt'
          ])
          && request.resource.data.usedQty is int
          && request.resource.data.damagedQty is int
          && request.resource.data.usedQty > resource.data.get('usedQty', 0)
          && request.resource.data.usedQty <= resource.data.totalQty
          && request.resource.data.damagedQty == (('damagedQty' in resource.data) ? resource.data.damagedQty : 0)
             + request.resource.data.usedQty - resource.data.get('usedQty', 0)
          && request.resource.data.lastDamageId is string
          && existsAfter(/databases/$(database)/documents/damage/$(request.resource.data.lastDamageId))
          && getAfter(/databases/$(database)/documents/damage/$(request.resource.data.lastDamageId)).data.ingredientId == id
          && getAfter(/databases/$(database)/documents/damage/$(request.resource.data.lastDamageId)).data.actorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/damage/$(request.resource.data.lastDamageId)).data.qty == request.resource.data.usedQty - resource.data.get('usedQty', 0)
        )
        || (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedQty','lastRefundId','updatedAt'
          ])
          && request.resource.data.usedQty is int
          && request.resource.data.usedQty >= 0
          && request.resource.data.usedQty < resource.data.get('usedQty', 0)
          && existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId))
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.refundedByUid == request.auth.uid
          && (
            (('needs' in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data)
              && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.needs[id] == resource.data.get('usedQty', 0) - request.resource.data.usedQty)
            || (('usedIngredients' in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data)
              && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.usedIngredients[id] == resource.data.get('usedQty', 0) - request.resource.data.usedQty)
          ));
      // 只有未使用且無毀損紀錄的原料可由最高管理員刪除。
      allow delete: if superAdmin()
        && resource.data.get('usedQty', 0) == 0
        && resource.data.get('damagedQty', 0) == 0;
    }
    match /damage/{id} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasOnly([
          'ingredientId','ingredientName','unit','qty','reason','unitCost','cost',
          'actorUid','actorName','seat','createdAt'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.ingredientId is string
        && request.resource.data.ingredientName is string
        && request.resource.data.unit is string
        && request.resource.data.qty is int
        && request.resource.data.qty >= 1
        && request.resource.data.qty <= 10000000
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 150
        && request.resource.data.unitCost is int
        && request.resource.data.cost == request.resource.data.qty * request.resource.data.unitCost
        && exists(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId))
        && request.resource.data.unitCost == get(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId)).data.unitCost
        && request.resource.data.ingredientName == get(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId)).data.name
        && request.resource.data.unit == get(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId)).data.unit
        && getAfter(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId)).data.lastDamageId == id
        && getAfter(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId)).data.usedQty == get(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId)).data.usedQty + request.resource.data.qty;
      allow update, delete: if false;
    }
    match /orderCounters/{day} {
      // 保留每日單號遞增，不再要求單次交易跨讀 sales/getAfter()。
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasOnly(['date','lastNo','lastOrderId','lastOrderNo','updatedAt'])
        && request.resource.data.date == day
        && request.resource.data.lastNo == 1
        && request.resource.data.lastOrderId is string
        && request.resource.data.lastOrderNo is string
        && request.resource.data.lastOrderNo.matches('^GD-[0-9]{8}-[0-9]{4,}$')
        && request.resource.data.updatedAt == request.time;
      allow update: if member()
        && request.resource.data.keys().hasOnly(['date','lastNo','lastOrderId','lastOrderNo','updatedAt'])
        && request.resource.data.date == day
        && resource.data.get('lastNo', 0) is int
        && request.resource.data.lastNo is int
        && request.resource.data.lastNo == resource.data.get('lastNo', 0) + 1
        && request.resource.data.lastNo <= 999999
        && request.resource.data.lastOrderId is string
        && request.resource.data.lastOrderNo is string
        && request.resource.data.lastOrderNo.matches('^GD-[0-9]{8}-[0-9]{4,}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /cashDrawerDays/{day} {
      // 只驗證本筆資料和帳號，不做昂貴的 sales/庫存跨文件 getAfter 核對。
      // 每天只有一個文件，交易依同文件序號更新，避免三台同時重複開店或閉店。
      allow read: if member();
      allow create: if member()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly([
          'date','status','openingCash','openedAt','openedByUid','openedByName',
          'updatedAt','lastCountAt','lastCountId','countNo'
        ])
        && request.resource.data.date == day
        && request.resource.data.status == 'open'
        && request.resource.data.openingCash is int
        && request.resource.data.openingCash >= 0 && request.resource.data.openingCash <= 10000000
        && request.resource.data.openedByUid == request.auth.uid
        && request.resource.data.openedByName is string
        && request.resource.data.openedByName.size() > 0 && request.resource.data.openedByName.size() <= 80
        && request.resource.data.openedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastCountAt == request.time
        && request.resource.data.lastCountId is string
        && request.resource.data.countNo == 1;
      allow update: if member()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','updatedAt','lastCountAt','lastCountId','countNo',
          'closedAt','closedByUid','closedByName','closingCash'
        ])
        && request.resource.data.date == day
        && request.resource.data.status in ['open','closed']
        && request.resource.data.countNo is int
        && request.resource.data.countNo == resource.data.countNo + 1
        && request.resource.data.countNo <= 10000
        && request.resource.data.lastCountId is string
        && request.resource.data.lastCountId != resource.data.lastCountId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastCountAt == request.time
        && (
          (request.resource.data.status == 'open' && !('closedAt' in request.resource.data))
          ||
          (request.resource.data.status == 'closed'
           && request.resource.data.closedAt == request.time
           && request.resource.data.closedByUid == request.auth.uid
           && request.resource.data.closedByName is string
           && request.resource.data.closedByName.size() > 0
           && request.resource.data.closedByName.size() <= 80
           && request.resource.data.closingCash is int
           && request.resource.data.closingCash >= 0
           && request.resource.data.closingCash <= 10000000)
        );
      allow delete: if false;
    }
    match /cashCounts/{id} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasOnly(['date','openingCash','denominations','countedCash','grossSales','refundAmount','expectedCash','variance','actorUid','actorName','createdAt','phase','countNo','note','snapshotAt'])
        // 保留舊版 cashCounts 文件寫入相容性；新增欄位僅對錢櫃管理進行基本格式驗證。
        && (!('phase' in request.resource.data) || (
             request.resource.data.phase in ['opening','periodic','closing']
             && request.resource.data.countNo is int
             && request.resource.data.countNo >= 1
             && request.resource.data.countNo <= 10000
             && request.resource.data.note is string
             && request.resource.data.note.size() <= 160
             && request.resource.data.snapshotAt is timestamp
           ))
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() > 0 && request.resource.data.actorName.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.openingCash is int
        && request.resource.data.openingCash >= 0 && request.resource.data.openingCash <= 10000000
        && request.resource.data.grossSales is int
        && request.resource.data.grossSales >= 0 && request.resource.data.grossSales <= 10000000
        && request.resource.data.refundAmount is int
        && request.resource.data.refundAmount >= 0 && request.resource.data.refundAmount <= 10000000
        && request.resource.data.denominations is map
        && request.resource.data.denominations.keys().hasOnly(['1000','500','100','50','10','5','1'])
        && request.resource.data.denominations.keys().hasAll(['1000','500','100','50','10','5','1'])
        && request.resource.data.denominations.values().size() == 7
        && request.resource.data.denominations['1000'] is int && request.resource.data.denominations['1000'] >= 0 && request.resource.data.denominations['1000'] <= 10000
        && request.resource.data.denominations['500'] is int && request.resource.data.denominations['500'] >= 0 && request.resource.data.denominations['500'] <= 10000
        && request.resource.data.denominations['100'] is int && request.resource.data.denominations['100'] >= 0 && request.resource.data.denominations['100'] <= 10000
        && request.resource.data.denominations['50'] is int && request.resource.data.denominations['50'] >= 0 && request.resource.data.denominations['50'] <= 10000
        && request.resource.data.denominations['10'] is int && request.resource.data.denominations['10'] >= 0 && request.resource.data.denominations['10'] <= 10000
        && request.resource.data.denominations['5'] is int && request.resource.data.denominations['5'] >= 0 && request.resource.data.denominations['5'] <= 10000
        && request.resource.data.denominations['1'] is int && request.resource.data.denominations['1'] >= 0 && request.resource.data.denominations['1'] <= 10000
        && request.resource.data.countedCash == request.resource.data.denominations['1000'] * 1000
          + request.resource.data.denominations['500'] * 500 + request.resource.data.denominations['100'] * 100
          + request.resource.data.denominations['50'] * 50 + request.resource.data.denominations['10'] * 10
          + request.resource.data.denominations['5'] * 5 + request.resource.data.denominations['1']
        && request.resource.data.countedCash <= 10000000
        && request.resource.data.expectedCash == request.resource.data.openingCash + request.resource.data.grossSales - request.resource.data.refundAmount
        && request.resource.data.expectedCash >= 0 && request.resource.data.expectedCash <= 10000000
        && request.resource.data.variance == request.resource.data.countedCash - request.resource.data.expectedCash;
      allow update, delete: if false;
    }
    match /sales/{id} {
      // 臨時簡化版：移除跨文件的商品價格 / 12 行逐項驗算 / 流水號 getAfter 驗證。
      // 仍限制登入成員、新增一次、金額基本一致；不能抵禦惡意修改客戶端偽造單價。
      allow read: if member();
      allow create: if member()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.status == 'valid'
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 12
        && request.resource.data.needs is map
        && request.resource.data.rollNeeds is map
        && request.resource.data.productDeltas is map
        && request.resource.data.baseTotal is int
        && request.resource.data.baseTotal >= 0
        && request.resource.data.baseTotal <= 10000000
        && request.resource.data.manualDiscount is int
        && request.resource.data.manualDiscount >= 0
        && request.resource.data.manualDiscount <= request.resource.data.baseTotal
        && request.resource.data.total is int
        && request.resource.data.total == request.resource.data.baseTotal - request.resource.data.manualDiscount
        && request.resource.data.total >= 0
        && request.resource.data.total <= 10000000
        && request.resource.data.paid is int
        && request.resource.data.paid >= request.resource.data.total
        && request.resource.data.change == request.resource.data.paid - request.resource.data.total
        && request.resource.data.fingerprint is string
        && request.resource.data.fingerprint.size() <= 12000
        && request.resource.data.orderNo is string
        && request.resource.data.orderNo.matches('^GD-[0-9]{8}-[0-9]{4,}$')
        && request.resource.data.orderDay is string
        && request.resource.data.orderDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.orderSequence is int
        && request.resource.data.orderSequence >= 1;
      allow update: if (superAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','refundReason','refundedByUid','refundedBySeat','refundedByName','refundedAt',
            'hidden','hiddenBy','hiddenAt'
          ])
          && request.resource.data.status == 'voided'
          && request.resource.data.refundReason == '26 號清空測試資料'
          && request.resource.data.refundedByUid == request.auth.uid
          && request.resource.data.refundedBySeat is int
          && request.resource.data.refundedBySeat >= 0
          && request.resource.data.refundedBySeat <= 99
          && request.resource.data.refundedBySeat == (superAdmin() ? 26 : get(accountPath()).data.seat)
          && request.resource.data.refundedByName is string
          && request.resource.data.refundedByName.size() > 0
          && request.resource.data.refundedByName.size() <= 80
          && request.resource.data.refundedAt == request.time
          && request.resource.data.hidden == true
          && request.resource.data.hiddenBy == request.auth.uid
          && request.resource.data.hiddenAt == request.time)
        || (member()
          && resource.data.status == 'valid'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','refundReason','refundedByUid','refundedBySeat','refundedByName','refundedAt'
          ])
          && request.resource.data.status == 'voided'
          && request.resource.data.refundedByUid == request.auth.uid
          && request.resource.data.refundedBySeat is int
          && request.resource.data.refundedBySeat == (superAdmin() ? 26 : get(accountPath()).data.seat)
          && request.resource.data.refundedByName is string
          && request.resource.data.refundedByName.size() > 0
          && request.resource.data.refundedByName.size() <= 80
          && request.resource.data.refundedAt == request.time
          && request.resource.data.refundReason is string
          && request.resource.data.refundReason.size() > 0
          && request.resource.data.refundReason.size() <= 150)
        || (superAdmin()
          && resource.data.status == 'voided'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hidden','hiddenBy','hiddenAt'
          ])
          && request.resource.data.hidden == true
          && request.resource.data.hiddenBy == request.auth.uid
          && request.resource.data.hiddenAt == request.time);
      allow delete: if false;
    }
    match /audit/{id} {
      allow read: if manager();
      allow create: if auditCheck()
        && request.resource.data.hidden == false
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 300;
      allow update: if superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hidden','hiddenBy','hiddenAt'
        ])
        && request.resource.data.hidden == true
        && request.resource.data.hiddenBy == request.auth.uid
        && request.resource.data.hiddenAt == request.time;
      allow delete: if false;
    }
  }
}
