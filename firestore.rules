rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() { return request.auth != null; }
    function superAdmin() {
      return loggedIn() && request.auth.token.email == 'seat-26@school-22aa0.firebaseapp.com';
    }
    function accountPath() {
      return /databases/$(database)/documents/accounts/$(request.auth.uid);
    }
    function activeAccount() {
      return loggedIn() && exists(accountPath())
        && get(accountPath()).data.email == request.auth.token.email
        && get(accountPath()).data.role in ['student','teacher','admin'];
    }
    function member() { return superAdmin() || activeAccount(); }
    function manager() {
      return superAdmin() || (activeAccount() && get(accountPath()).data.role in ['admin','teacher']);
    }
    function auditCheck() {
      return member()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }
    match /accounts/{uid} {
      allow read: if superAdmin() || (loggedIn() && request.auth.uid == uid);
      allow create: if superAdmin()
        && uid != request.auth.uid
        && request.resource.data.role in ['admin','teacher','student']
        && request.resource.data.seat is int
        && request.resource.data.seat >= 0 && request.resource.data.seat <= 99
        && request.resource.data.seat != 26
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','updatedBy','updatedAt'])
        && request.resource.data.role in ['admin','teacher','student']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /meta/{id} {
      allow read: if member() || id == 'customerOrdering';
      allow create, update: if (manager() && id == 'settings'
        && request.resource.data.sharedCost is int
        && request.resource.data.sharedCost >= 0
        && request.resource.data.stallName is string
        && request.resource.data.stallName.size() <= 45)
        || (manager() && id == 'customerOrdering'
          && request.resource.data.keys().hasOnly(['enabled','updatedAt','updatedBy'])
          && request.resource.data.keys().hasAll(['enabled','updatedAt','updatedBy'])
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid);
      allow delete: if false;
    }
    match /promotions/{id} {
      allow read: if member();
      allow create: if manager()
        && request.resource.data.productA is string
        && request.resource.data.productB is string
        && request.resource.data.productA != request.resource.data.productB
        && request.resource.data.price is int
        && request.resource.data.price >= 0
        && request.resource.data.price <= 10000000;
      allow update, delete: if false;
    }
    // Public menu is a manager-published projection: NEVER expose /products costs and recipes.
    match /menuPublic/{id} {
      allow read: if true;
      allow create, update: if manager()
        && request.resource.data.keys().hasOnly(['name','category','unit','price','hidden','addons','publishedAt'])
        && request.resource.data.keys().hasAll(['name','category','unit','price','hidden','publishedAt'])
        && request.resource.data.publishedAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.category is string
        && request.resource.data.unit is string
        && request.resource.data.price is int && request.resource.data.price >= 1
        && request.resource.data.hidden is bool
        && (!('addons' in request.resource.data) || (request.resource.data.addons is list && request.resource.data.addons.size() <= 12))
        && existsAfter(/databases/$(database)/documents/products/$(id))
        && request.resource.data.name == getAfter(/databases/$(database)/documents/products/$(id)).data.name
        && request.resource.data.category == getAfter(/databases/$(database)/documents/products/$(id)).data.category
        && request.resource.data.unit == getAfter(/databases/$(database)/documents/products/$(id)).data.unit
        && request.resource.data.price == getAfter(/databases/$(database)/documents/products/$(id)).data.price
        && request.resource.data.hidden == getAfter(/databases/$(database)/documents/products/$(id)).data.get('hidden',false);
      allow delete: if false;
    }
    // 10 分鐘未付款顧客訂單。公開僅能用高熵 ID 單筆讀取，不可列舉。
    match /customerOrders/{id} {
      function validLine(l) {
        return l is map && l.keys().hasOnly(['productId','qty','extras'])
          && l.keys().hasAll(['productId','qty','extras'])
          && l.productId is string && l.productId.size() > 0 && l.productId.size() <= 128
          && l.qty is int && l.qty >= 1 && l.qty <= 12
          && l.extras is list && l.extras.size() <= 12;
      }
      function lineValidAt(data,n) {
        return n >= data.items.size() || validLine(data.items[n]);
      }
      function guestOrderValid(data) {
        return id.matches('^[0-9a-f]{32}$')
          && data.keys().hasOnly(['status','createdAt','items','estimateTotal'])
          && data.keys().hasAll(['status','createdAt','items','estimateTotal'])
          && data.status == 'pending' && data.createdAt == request.time
          && data.estimateTotal is int && data.estimateTotal >= 0 && data.estimateTotal <= 10000000
          && data.items is list && data.items.size() > 0 && data.items.size() <= 12
          && lineValidAt(data,0) && lineValidAt(data,1) && lineValidAt(data,2)
          && lineValidAt(data,3) && lineValidAt(data,4) && lineValidAt(data,5)
          && lineValidAt(data,6) && lineValidAt(data,7) && lineValidAt(data,8)
          && lineValidAt(data,9) && lineValidAt(data,10) && lineValidAt(data,11);
      }
      allow get: if true;
      allow list: if member();
      // Service may be disabled by managers; rule enforces it even if public HTML is modified.
      allow create: if exists(/databases/$(database)/documents/meta/customerOrdering)
        && get(/databases/$(database)/documents/meta/customerOrdering).data.enabled == true
        && guestOrderValid(request.resource.data);
      function paidLineMatch(lines,items,idx) {
        // A cashier may change a line quantity. 12 limits groups, not units per group.
        return idx >= items.size() || (
          items[idx] is map && items[idx].keys().hasOnly(['productId','qty','extras'])
          && items[idx].keys().hasAll(['productId','qty','extras'])
          && items[idx].productId is string && items[idx].productId.size() > 0
          && items[idx].productId.size() <= 128
          && items[idx].qty is int && items[idx].qty >= 1 && items[idx].qty <= 10000
          && items[idx].extras is list && items[idx].extras.size() <= 12
          && lines[idx].productId == items[idx].productId
          && lines[idx].qty == items[idx].qty);
      }
      function linkedPaidSale(data) {
        let sale = getAfter(/databases/$(database)/documents/sales/$(data.saleId)).data;
        return sale.status == 'valid' && sale.customerOrderId == id
          && sale.actorUid == request.auth.uid && sale.createdAt == request.time
          && data.finalTotal is int && data.finalTotal == sale.total
          && data.editedByCashier is bool
          && data.finalItems is list && data.finalItems.size() > 0
          && data.finalItems.size() <= 12 && data.finalItems.size() == sale.lines.size()
          && paidLineMatch(sale.lines,data.finalItems,0) && paidLineMatch(sale.lines,data.finalItems,1)
          && paidLineMatch(sale.lines,data.finalItems,2) && paidLineMatch(sale.lines,data.finalItems,3)
          && paidLineMatch(sale.lines,data.finalItems,4) && paidLineMatch(sale.lines,data.finalItems,5)
          && paidLineMatch(sale.lines,data.finalItems,6) && paidLineMatch(sale.lines,data.finalItems,7)
          && paidLineMatch(sale.lines,data.finalItems,8) && paidLineMatch(sale.lines,data.finalItems,9)
          && paidLineMatch(sale.lines,data.finalItems,10) && paidLineMatch(sale.lines,data.finalItems,11);
      }
      allow update: if member()
        && resource.data.status == 'pending'
        && request.time < resource.data.createdAt + duration.value(10, 'm')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','paidAt','paidBy','saleId','finalTotal','finalItems','editedByCashier'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status','paidAt','paidBy','saleId','finalTotal','finalItems','editedByCashier'])
        && request.resource.data.status == 'paid'
        && request.resource.data.paidAt == request.time
        && request.resource.data.paidBy == request.auth.uid
        && request.resource.data.saleId is string
        && linkedPaidSale(request.resource.data);
      // 學生收銀員可刪除未付廢單；到期後開站的訪客也可清理。
      allow delete: if resource.data.status == 'pending' &&
        (member() || request.time >= resource.data.createdAt + duration.value(10, 'm'));
    }
    match /products/{id} {
      function linkedSaleProductChange() {
        let sale = getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data;
        return sale.actorUid == request.auth.uid
          && sale.createdAt == request.time && sale.status == 'valid'
          && sale.productDeltas[id].sold == request.resource.data.sold - resource.data.get('sold', 0)
          && sale.productDeltas[id].revenue == request.resource.data.revenue - resource.data.get('revenue', 0);
      }
      function linkedRollQty() {
        let sale = getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data;
        return resource.data.get('manualStock',0) - request.resource.data.manualStock == sale.productDeltas[id].rollQty;
      }
      allow read: if member();
      allow create: if manager()
        && request.resource.data.sold == 0
        && request.resource.data.revenue == 0
        && request.resource.data.price is int
        && request.resource.data.price >= 1
        && request.resource.data.price <= 10000000
        && request.resource.data.manualStock == 0
        && request.resource.data.unitCost is int
        && request.resource.data.unitCost >= 0
        && request.resource.data.unitCost <= 10000000
        && request.resource.data.recipe is list
        && request.resource.data.addonOptions is list
        && request.resource.data.rollAddonOptions is list
        && request.resource.data.addonOptions.size() <= 12
        && request.resource.data.rollAddonOptions.size() <= 12
        && ((request.resource.data.category == '飯捲' && request.resource.data.recipe.size() == 0)
         || (request.resource.data.category == '冰淇淋'
           && request.resource.data.recipe.size() > 0
           && request.resource.data.recipe.size() <= 12
           && request.resource.data.rollAddonOptions.size() == 0));
      allow update: if (superAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sold','revenue','lastResetBy','lastResetAt'
          ])
          && request.resource.data.sold == 0
          && request.resource.data.revenue == 0
          && request.resource.data.lastResetBy == request.auth.uid
          && request.resource.data.lastResetAt == request.time)
        || (manager()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name','category','unit','price','unitCost','recipe','addonOptions','rollAddonOptions','hidden','updatedAt'
          ])
          && request.resource.data.price is int
          && request.resource.data.price > 0
          && request.resource.data.category in ['飯捲','冰淇淋','冰品']
          && request.resource.data.unitCost is int
          && request.resource.data.unitCost >= 0
          && request.resource.data.recipe is list
          && request.resource.data.rollAddonOptions is list
          && ((request.resource.data.category == '飯捲' && request.resource.data.recipe.size() == 0)
           || (request.resource.data.category == '冰淇淋' && request.resource.data.recipe.size() > 0)))
        || (member()
          && resource.data.category in ['飯捲','飯卷','飯糰']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'manualStock','lastStockAuditId','updatedAt'
          ])
          && request.resource.data.manualStock is int
          && request.resource.data.manualStock >= 0
          && request.resource.data.manualStock <= 10000000
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastStockAuditId is string
          && getAfter(/databases/$(database)/documents/audit/$(request.resource.data.lastStockAuditId)).data.action == 'roll.stock.adjust'
          && getAfter(/databases/$(database)/documents/audit/$(request.resource.data.lastStockAuditId)).data.subjectId == id
          && getAfter(/databases/$(database)/documents/audit/$(request.resource.data.lastStockAuditId)).data.actorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/audit/$(request.resource.data.lastStockAuditId)).data.oldStock == resource.data.get('manualStock',0)
          && getAfter(/databases/$(database)/documents/audit/$(request.resource.data.lastStockAuditId)).data.newStock == request.resource.data.manualStock)
        || (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sold','revenue','manualStock','lastOrderId','updatedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.sold is int
          && resource.data.get('sold', 0) is int
          && resource.data.get('revenue', 0) is int
          && request.resource.data.sold > resource.data.get('sold', 0)
          && request.resource.data.revenue is int
          && request.resource.data.revenue >= resource.data.get('revenue', 0)
          && linkedSaleProductChange()
          && ((resource.data.category in ['飯捲','飯卷','飯糰']
            && request.resource.data.manualStock is int
            && request.resource.data.manualStock >= 0
            && linkedRollQty())
           || (resource.data.category in ['冰淇淋','冰品']
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['manualStock']))))
        || (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'sold','revenue','manualStock','lastRefundId','updatedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.sold is int
          && request.resource.data.sold >= 0
          && request.resource.data.sold < resource.data.sold
          && request.resource.data.revenue is int
          && request.resource.data.revenue >= 0
          && request.resource.data.revenue <= resource.data.revenue
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.status == 'voided'
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.refundedByUid == request.auth.uid
          && ((('productDeltas' in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data)
            && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.productDeltas[id].sold == resource.data.sold - request.resource.data.sold
            && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.productDeltas[id].revenue == resource.data.revenue - request.resource.data.revenue
            && ((resource.data.category in ['飯捲','飯卷','飯糰']
              && request.resource.data.get('manualStock',0) - resource.data.get('manualStock',0) == getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.productDeltas[id].rollQty)
             || !(resource.data.category in ['飯捲','飯卷','飯糰'])))
           || !('productDeltas' in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data)));
      allow delete: if false;
    }
    match /rollIngredients/{id} {
      allow read: if member();
      allow create: if manager()
        && request.resource.data.keys().hasOnly(['name','unit','defaultPrice','unitCost','hidden','createdAt','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0 && request.resource.data.unit.size() <= 12
        && request.resource.data.defaultPrice is int
        && request.resource.data.defaultPrice >= 0 && request.resource.data.defaultPrice <= 10000000
        && request.resource.data.unitCost is int
        && request.resource.data.unitCost >= 0 && request.resource.data.unitCost <= 10000000
        && request.resource.data.hidden is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if manager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','unit','defaultPrice','unitCost','hidden','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0 && request.resource.data.unit.size() <= 12
        && request.resource.data.defaultPrice is int
        && request.resource.data.defaultPrice >= 0 && request.resource.data.defaultPrice <= 10000000
        && request.resource.data.unitCost is int
        && request.resource.data.unitCost >= 0 && request.resource.data.unitCost <= 10000000
        && request.resource.data.hidden is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /ingredients/{id} {
      function linkedSaleIngredientChange() {
        let sale = getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastOrderId)).data;
        return sale.actorUid == request.auth.uid
          && sale.createdAt == request.time && sale.status == 'valid'
          && sale.needs[id] == request.resource.data.usedQty - resource.data.usedQty;
      }
      allow read: if member();
      allow create: if manager()
        && request.resource.data.name is string
        && request.resource.data.unit is string
        && request.resource.data.totalQty is int
        && request.resource.data.totalQty >= 0
        && request.resource.data.totalQty <= 10000000
        && request.resource.data.unitCost is int
        && request.resource.data.unitCost >= 0
        && request.resource.data.unitCost <= 10000000
        && request.resource.data.usedQty == 0;
      allow update: if (superAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedQty','lastResetBy','lastResetAt'
          ])
          && request.resource.data.usedQty == (('damagedQty' in resource.data) ? resource.data.damagedQty : 0)
          && request.resource.data.lastResetBy == request.auth.uid
          && request.resource.data.lastResetAt == request.time)
        || (manager()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','unit','totalQty','unitCost','updatedAt'
          ])
          && request.resource.data.totalQty is int
          && request.resource.data.totalQty >= resource.data.usedQty
          && request.resource.data.totalQty <= 10000000)
        || (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedQty','damagedQty','lastDamageId','updatedAt'
          ])
          && request.resource.data.usedQty is int
          && request.resource.data.damagedQty is int
          && request.resource.data.usedQty > resource.data.usedQty
          && request.resource.data.usedQty <= resource.data.totalQty
          && request.resource.data.damagedQty == (('damagedQty' in resource.data) ? resource.data.damagedQty : 0)
             + request.resource.data.usedQty - resource.data.usedQty
          && request.resource.data.lastDamageId is string
          && existsAfter(/databases/$(database)/documents/damage/$(request.resource.data.lastDamageId))
          && getAfter(/databases/$(database)/documents/damage/$(request.resource.data.lastDamageId)).data.ingredientId == id
          && getAfter(/databases/$(database)/documents/damage/$(request.resource.data.lastDamageId)).data.actorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/damage/$(request.resource.data.lastDamageId)).data.qty == request.resource.data.usedQty - resource.data.usedQty
        )
        || (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedQty','lastOrderId','updatedAt'
          ])
          && request.resource.data.usedQty is int
          && request.resource.data.usedQty > resource.data.usedQty
          && request.resource.data.usedQty <= resource.data.totalQty
          && request.resource.data.updatedAt == request.time
          && linkedSaleIngredientChange())
        || (member()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'usedQty','lastRefundId','updatedAt'
          ])
          && request.resource.data.usedQty is int
          && request.resource.data.usedQty >= 0
          && request.resource.data.usedQty < resource.data.usedQty
          && existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId))
          && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.refundedByUid == request.auth.uid
          && (
            (('needs' in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data)
              && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.needs[id] == resource.data.usedQty - request.resource.data.usedQty)
            || (('usedIngredients' in getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data)
              && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.lastRefundId)).data.usedIngredients[id] == resource.data.usedQty - request.resource.data.usedQty)
          ));
      allow delete: if false;
    }
    match /damage/{id} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasOnly([
          'ingredientId','ingredientName','unit','qty','reason','unitCost','cost',
          'actorUid','actorName','seat','createdAt'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.ingredientId is string
        && request.resource.data.ingredientName is string
        && request.resource.data.unit is string
        && request.resource.data.qty is int
        && request.resource.data.qty >= 1
        && request.resource.data.qty <= 10000000
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 150
        && request.resource.data.unitCost is int
        && request.resource.data.cost == request.resource.data.qty * request.resource.data.unitCost
        && exists(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId))
        && request.resource.data.unitCost == get(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId)).data.unitCost
        && request.resource.data.ingredientName == get(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId)).data.name
        && request.resource.data.unit == get(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId)).data.unit
        && getAfter(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId)).data.lastDamageId == id
        && getAfter(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId)).data.usedQty == get(/databases/$(database)/documents/ingredients/$(request.resource.data.ingredientId)).data.usedQty + request.resource.data.qty;
      allow update, delete: if false;
    }
    function orderIngredientUpdated(saleId, sale, idx) {
      return idx >= sale.needs.keys().size() || ingredientMatchesSale(saleId, sale, sale.needs.keys()[idx]);
    }
    function ingredientMatchesSale(saleId, sale, ingredientId) {
      let stock = getAfter(/databases/$(database)/documents/ingredients/$(ingredientId)).data;
      return ingredientId is string
        && sale.needs[ingredientId] is int
        && sale.needs[ingredientId] >= 1
        && stock.lastOrderId == saleId
        && stock.updatedAt == request.time;
    }
    function saleNeedsHaveStockUpdates(saleId) {
      let sale = getAfter(/databases/$(database)/documents/sales/$(saleId)).data;
      return sale.needs is map && sale.needs.keys().size() <= 8
        && orderIngredientUpdated(saleId,sale,0) && orderIngredientUpdated(saleId,sale,1)
        && orderIngredientUpdated(saleId,sale,2) && orderIngredientUpdated(saleId,sale,3)
        && orderIngredientUpdated(saleId,sale,4) && orderIngredientUpdated(saleId,sale,5)
        && orderIngredientUpdated(saleId,sale,6) && orderIngredientUpdated(saleId,sale,7);
    }
    function currentCounterSaleMatches(data) {
      let sale = getAfter(/databases/$(database)/documents/sales/$(data.lastOrderId)).data;
      return sale.status == 'valid'
        && sale.actorUid == request.auth.uid
        && sale.createdAt == request.time
        && sale.orderNo == data.lastOrderNo;
    }
    match /orderCounters/{day} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasOnly(['date','lastNo','lastOrderId','lastOrderNo','updatedAt'])
        && request.resource.data.date == day
        && request.resource.data.lastNo == 1
        && request.resource.data.lastOrderId is string
        && request.resource.data.lastOrderNo is string
        && request.resource.data.updatedAt == request.time
        && currentCounterSaleMatches(request.resource.data)
        && saleNeedsHaveStockUpdates(request.resource.data.lastOrderId);
      allow update: if member()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastNo','lastOrderId','lastOrderNo','updatedAt'])
        && request.resource.data.date == day
        && request.resource.data.lastNo is int
        && request.resource.data.lastNo == resource.data.lastNo + 1
        && request.resource.data.lastNo <= 999999
        && request.resource.data.lastOrderId is string
        && request.resource.data.lastOrderNo is string
        && request.resource.data.updatedAt == request.time
        && currentCounterSaleMatches(request.resource.data)
        && saleNeedsHaveStockUpdates(request.resource.data.lastOrderId);
      allow delete: if false;
    }
    match /cashCounts/{id} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.keys().hasOnly(['date','openingCash','denominations','countedCash','grossSales','refundAmount','expectedCash','variance','actorUid','actorName','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() > 0 && request.resource.data.actorName.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.openingCash is int
        && request.resource.data.openingCash >= 0 && request.resource.data.openingCash <= 10000000
        && request.resource.data.grossSales is int
        && request.resource.data.grossSales >= 0 && request.resource.data.grossSales <= 10000000
        && request.resource.data.refundAmount is int
        && request.resource.data.refundAmount >= 0 && request.resource.data.refundAmount <= 10000000
        && request.resource.data.denominations is map
        && request.resource.data.denominations.keys().hasOnly(['1000','500','100','50','10','5','1'])
        && request.resource.data.denominations.keys().hasAll(['1000','500','100','50','10','5','1'])
        && request.resource.data.denominations.values().size() == 7
        && request.resource.data.denominations['1000'] is int && request.resource.data.denominations['1000'] >= 0 && request.resource.data.denominations['1000'] <= 10000
        && request.resource.data.denominations['500'] is int && request.resource.data.denominations['500'] >= 0 && request.resource.data.denominations['500'] <= 10000
        && request.resource.data.denominations['100'] is int && request.resource.data.denominations['100'] >= 0 && request.resource.data.denominations['100'] <= 10000
        && request.resource.data.denominations['50'] is int && request.resource.data.denominations['50'] >= 0 && request.resource.data.denominations['50'] <= 10000
        && request.resource.data.denominations['10'] is int && request.resource.data.denominations['10'] >= 0 && request.resource.data.denominations['10'] <= 10000
        && request.resource.data.denominations['5'] is int && request.resource.data.denominations['5'] >= 0 && request.resource.data.denominations['5'] <= 10000
        && request.resource.data.denominations['1'] is int && request.resource.data.denominations['1'] >= 0 && request.resource.data.denominations['1'] <= 10000
        && request.resource.data.countedCash == request.resource.data.denominations['1000'] * 1000
          + request.resource.data.denominations['500'] * 500 + request.resource.data.denominations['100'] * 100
          + request.resource.data.denominations['50'] * 50 + request.resource.data.denominations['10'] * 10
          + request.resource.data.denominations['5'] * 5 + request.resource.data.denominations['1']
        && request.resource.data.countedCash <= 10000000
        && request.resource.data.expectedCash == request.resource.data.openingCash + request.resource.data.grossSales - request.resource.data.refundAmount
        && request.resource.data.expectedCash >= 0 && request.resource.data.expectedCash <= 10000000
        && request.resource.data.variance == request.resource.data.countedCash - request.resource.data.expectedCash;
      allow update, delete: if false;
    }
    match /sales/{id} {
      // 【安全規則】逐項驗算：單價以商品資料庫為準，總額不可只靠前端傳值。
      // Firestore Rules 沒有迴圈，最多驗證 12 組；前端限制不同主商品 8 種以控制 get() 次數。
      function extraAmount(extras, idx) {
        return idx < extras.size() ? extras[idx].price * extras[idx].qty : 0;
      }
      function validExtraAt(extras, idx) {
        return idx >= extras.size() || (
          extras[idx] is map
          && extras[idx].id is string
          && extras[idx].qty is int && extras[idx].qty >= 1 && extras[idx].qty <= 10000
          && extras[idx].price is int && extras[idx].price >= 0 && extras[idx].price <= 10000000
          && extras[idx].netAmount is int && extras[idx].netAmount >= 0
          && extras[idx].netAmount <= extras[idx].price * extras[idx].qty
        );
      }
      function validExtras(extras) {
        return extras is list && extras.size() <= 12 && (
          validExtraAt(extras, 0) &&
      validExtraAt(extras, 1) &&
      validExtraAt(extras, 2) &&
      validExtraAt(extras, 3) &&
      validExtraAt(extras, 4) &&
      validExtraAt(extras, 5) &&
      validExtraAt(extras, 6) &&
      validExtraAt(extras, 7) &&
      validExtraAt(extras, 8) &&
      validExtraAt(extras, 9) &&
      validExtraAt(extras, 10) &&
      validExtraAt(extras, 11)
        );
      }
      function extrasTotal(extras) {
        return extraAmount(extras, 0) +
      extraAmount(extras, 1) +
      extraAmount(extras, 2) +
      extraAmount(extras, 3) +
      extraAmount(extras, 4) +
      extraAmount(extras, 5) +
      extraAmount(extras, 6) +
      extraAmount(extras, 7) +
      extraAmount(extras, 8) +
      extraAmount(extras, 9) +
      extraAmount(extras, 10) +
      extraAmount(extras, 11);
      }
      function validSaleLineAt(lines, idx) {
        return idx >= lines.size() || validSaleLine(lines[idx]);
      }
      function validSaleLine(line) {
        return line is map
          && line.productId is string && line.qty is int && line.qty >= 1 && line.qty <= 10000
          && line.price is int && line.price >= 0 && line.price <= 10000000
          && line.gross is int && line.gross == line.price * line.qty
          && validExtras(line.extras)
          && line.addonTotal is int && line.addonTotal == extrasTotal(line.extras)
          && line.promoDiscount is int && line.promoDiscount >= 0
          && line.manualDiscount is int && line.manualDiscount >= 0
          && line.discount is int && line.discount == line.promoDiscount + line.manualDiscount
          && line.discount <= line.gross + line.addonTotal
          && line.lineTotal is int && line.lineTotal >= 0
          && line.lineTotal == line.gross + line.addonTotal - line.discount
          && (line.productId == '__manual_other__'
              ? (line.qty == 1 && line.category == '其它' && line.name is string
                 && line.name.size() > 0 && line.name.size() <= 60
                 && line.reason is string && line.reason.size() > 0 && line.reason.size() <= 160
                 && line.extras.size() == 0)
              : validCatalogPrice(line));
      }
      function recipeNeedMinimum(line, product, idx) {
        return idx >= product.recipe.size() || (
          product.recipe[idx].id in request.resource.data.needs
          && request.resource.data.needs[product.recipe[idx].id] is int
          && request.resource.data.needs[product.recipe[idx].id] >= product.recipe[idx].qty * line.qty
        );
      }
      function catalogRecipeNeedsCovered(line, product) {
        return product.category in ['飯捲','飯卷','飯糰'] || (
          product.recipe is list && product.recipe.size() > 0 && product.recipe.size() <= 12
          && recipeNeedMinimum(line,product,0) && recipeNeedMinimum(line,product,1)
          && recipeNeedMinimum(line,product,2) && recipeNeedMinimum(line,product,3)
          && recipeNeedMinimum(line,product,4) && recipeNeedMinimum(line,product,5)
          && recipeNeedMinimum(line,product,6) && recipeNeedMinimum(line,product,7)
          && recipeNeedMinimum(line,product,8) && recipeNeedMinimum(line,product,9)
          && recipeNeedMinimum(line,product,10) && recipeNeedMinimum(line,product,11)
        );
      }
      function validCatalogPrice(line) {
        // getAfter ties the catalog price check to a product updated in THIS atomic sale.
        let product = getAfter(/databases/$(database)/documents/products/$(line.productId)).data;
        return catalogRecipeNeedsCovered(line, product)
          && product.lastOrderId == id
          && product.updatedAt == request.time
          && line.productId in request.resource.data.productDeltas
          && product.price == line.price
          && product.name == line.name
          && product.category == line.category
          && product.unit == line.unit
          && product.get('hidden', false) != true;
      }
      function sumSold(lines, productId, idx) {
        return idx < lines.size() && lines[idx].productId == productId ? lines[idx].qty : 0;
      }
      function sumRevenue(lines, productId, idx) {
        return idx < lines.size() && lines[idx].productId == productId ? lines[idx].lineTotal : 0;
      }
      function deltaProductMatches(data, idx) {
        return idx >= data.productDeltas.keys().size() || deltaProductMatchesId(data, data.productDeltas.keys()[idx]);
      }
      function deltaProductMatchesId(data, productId) {
        let product = getAfter(/databases/$(database)/documents/products/$(productId)).data;
        return productId is string
          && data.productDeltas[productId] is map
          && data.productDeltas[productId].sold is int
          && data.productDeltas[productId].sold > 0
          && data.productDeltas[productId].revenue is int
          && data.productDeltas[productId].revenue >= 0
          && data.productDeltas[productId].rollQty is int
          && (product.category in ['飯捲','飯卷','飯糰']
               ? (data.productDeltas[productId].rollQty == data.productDeltas[productId].sold
                 && data.rollNeeds[productId] == data.productDeltas[productId].rollQty)
               : data.productDeltas[productId].rollQty == 0)
          && product.lastOrderId == id
          && product.updatedAt == request.time
          && data.productDeltas[productId].sold == (
            sumSold(data.lines,productId,0) + sumSold(data.lines,productId,1)
            + sumSold(data.lines,productId,2) + sumSold(data.lines,productId,3)
            + sumSold(data.lines,productId,4) + sumSold(data.lines,productId,5)
            + sumSold(data.lines,productId,6) + sumSold(data.lines,productId,7)
            + sumSold(data.lines,productId,8) + sumSold(data.lines,productId,9)
            + sumSold(data.lines,productId,10) + sumSold(data.lines,productId,11)
          )
          && data.productDeltas[productId].revenue == (
            sumRevenue(data.lines,productId,0) + sumRevenue(data.lines,productId,1)
            + sumRevenue(data.lines,productId,2) + sumRevenue(data.lines,productId,3)
            + sumRevenue(data.lines,productId,4) + sumRevenue(data.lines,productId,5)
            + sumRevenue(data.lines,productId,6) + sumRevenue(data.lines,productId,7)
            + sumRevenue(data.lines,productId,8) + sumRevenue(data.lines,productId,9)
            + sumRevenue(data.lines,productId,10) + sumRevenue(data.lines,productId,11)
          );
      }
      function allProductDeltasMatch(data) {
        return data.productDeltas.keys().size() <= 8
          && data.rollNeeds.keys().hasOnly(data.productDeltas.keys())
          && deltaProductMatches(data,0) && deltaProductMatches(data,1)
          && deltaProductMatches(data,2) && deltaProductMatches(data,3)
          && deltaProductMatches(data,4) && deltaProductMatches(data,5)
          && deltaProductMatches(data,6) && deltaProductMatches(data,7);
      }
      function saleLineNet(lines, idx) {
        return idx < lines.size() ? lines[idx].lineTotal : 0;
      }
      function saleLineBase(lines, idx) {
        return idx < lines.size() ? lines[idx].gross + lines[idx].addonTotal - lines[idx].promoDiscount : 0;
      }
      function saleLineManual(lines, idx) {
        return idx < lines.size() ? lines[idx].manualDiscount : 0;
      }
      function saleLinePromo(lines, idx) {
        return idx < lines.size() ? lines[idx].promoDiscount : 0;
      }
      function consistentSaleAmounts(data) {
        return (
          validSaleLineAt(data.lines, 0) &&
          validSaleLineAt(data.lines, 1) &&
          validSaleLineAt(data.lines, 2) &&
          validSaleLineAt(data.lines, 3) &&
          validSaleLineAt(data.lines, 4) &&
          validSaleLineAt(data.lines, 5) &&
          validSaleLineAt(data.lines, 6) &&
          validSaleLineAt(data.lines, 7) &&
          validSaleLineAt(data.lines, 8) &&
          validSaleLineAt(data.lines, 9) &&
          validSaleLineAt(data.lines, 10) &&
          validSaleLineAt(data.lines, 11)
        )
        && data.total == (
          saleLineNet(data.lines, 0) +
          saleLineNet(data.lines, 1) +
          saleLineNet(data.lines, 2) +
          saleLineNet(data.lines, 3) +
          saleLineNet(data.lines, 4) +
          saleLineNet(data.lines, 5) +
          saleLineNet(data.lines, 6) +
          saleLineNet(data.lines, 7) +
          saleLineNet(data.lines, 8) +
          saleLineNet(data.lines, 9) +
          saleLineNet(data.lines, 10) +
          saleLineNet(data.lines, 11)
        )
        && data.baseTotal == (
          saleLineBase(data.lines, 0) +
          saleLineBase(data.lines, 1) +
          saleLineBase(data.lines, 2) +
          saleLineBase(data.lines, 3) +
          saleLineBase(data.lines, 4) +
          saleLineBase(data.lines, 5) +
          saleLineBase(data.lines, 6) +
          saleLineBase(data.lines, 7) +
          saleLineBase(data.lines, 8) +
          saleLineBase(data.lines, 9) +
          saleLineBase(data.lines, 10) +
          saleLineBase(data.lines, 11)
        )
        && data.manualDiscount == (
          saleLineManual(data.lines, 0) +
          saleLineManual(data.lines, 1) +
          saleLineManual(data.lines, 2) +
          saleLineManual(data.lines, 3) +
          saleLineManual(data.lines, 4) +
          saleLineManual(data.lines, 5) +
          saleLineManual(data.lines, 6) +
          saleLineManual(data.lines, 7) +
          saleLineManual(data.lines, 8) +
          saleLineManual(data.lines, 9) +
          saleLineManual(data.lines, 10) +
          saleLineManual(data.lines, 11)
        )
        && data.promoDiscount is int && data.promoDiscount == (
          saleLinePromo(data.lines, 0) +
          saleLinePromo(data.lines, 1) +
          saleLinePromo(data.lines, 2) +
          saleLinePromo(data.lines, 3) +
          saleLinePromo(data.lines, 4) +
          saleLinePromo(data.lines, 5) +
          saleLinePromo(data.lines, 6) +
          saleLinePromo(data.lines, 7) +
          saleLinePromo(data.lines, 8) +
          saleLinePromo(data.lines, 9) +
          saleLinePromo(data.lines, 10) +
          saleLinePromo(data.lines, 11)
        )
        && data.discount is int && data.discount == data.promoDiscount + data.manualDiscount;
      }
      function customerPaymentMatches(sale) {
        let order = getAfter(/databases/$(database)/documents/customerOrders/$(sale.customerOrderId)).data;
        return order.status == 'paid' && order.saleId == id
          && order.paidBy == request.auth.uid && order.paidAt == request.time;
      }
      function counterMatches(sale) {
        let counter = getAfter(/databases/$(database)/documents/orderCounters/$(sale.orderDay)).data;
        return counter.lastOrderId == id
          && counter.lastNo == sale.orderSequence
          && counter.lastOrderNo == sale.orderNo;
      }
      allow read: if member();
      allow create: if member()
        && request.resource.data.actorUid == request.auth.uid
        && (!('customerOrderId' in request.resource.data) || (
             request.resource.data.customerOrderId is string
             && customerPaymentMatches(request.resource.data)
           ))
        && request.resource.data.status == 'valid'
        && request.resource.data.createdAt == request.time
        && request.resource.data.hidden == false
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 12
        && request.resource.data.needs is map
        && request.resource.data.rollNeeds is map
        && request.resource.data.productDeltas is map
        && request.resource.data.manualDiscount is int
        && request.resource.data.baseTotal is int
        && request.resource.data.baseTotal >= 0
        && request.resource.data.manualDiscount >= 0
        && request.resource.data.manualDiscount <= request.resource.data.baseTotal
        && request.resource.data.manualReason is string
        && (request.resource.data.manualDiscount == 0
            || (request.resource.data.manualReason.size() >= 1
                && request.resource.data.manualReason.size() <= 150))
        && request.resource.data.total is int
        && request.resource.data.total == request.resource.data.baseTotal - request.resource.data.manualDiscount
        && request.resource.data.total >= 0
        && request.resource.data.total <= 10000000
        && request.resource.data.fingerprint is string
        && request.resource.data.fingerprint.size() <= 12000
        && request.resource.data.paid is int
        && request.resource.data.paid >= request.resource.data.total
        && request.resource.data.change == request.resource.data.paid - request.resource.data.total
        && allProductDeltasMatch(request.resource.data)
        && consistentSaleAmounts(request.resource.data)
        && request.resource.data.orderNo is string
        && request.resource.data.orderNo.matches('^GD-[0-9]{8}-[0-9]{4,}$')
        && request.resource.data.orderDay is string
        && request.resource.data.orderSequence is int
        && request.resource.data.orderSequence >= 1
        && counterMatches(request.resource.data);
      allow update: if (superAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','refundReason','refundedByUid','refundedBySeat','refundedByName','refundedAt',
            'hidden','hiddenBy','hiddenAt'
          ])
          && request.resource.data.status == 'voided'
          && request.resource.data.refundReason == '26 號清空測試資料'
          && request.resource.data.refundedByUid == request.auth.uid
          && request.resource.data.refundedBySeat is int
          && request.resource.data.refundedBySeat >= 0
          && request.resource.data.refundedBySeat <= 99
          && request.resource.data.refundedBySeat == (superAdmin() ? 26 : get(accountPath()).data.seat)
          && request.resource.data.refundedByName is string
          && request.resource.data.refundedByName.size() > 0
          && request.resource.data.refundedByName.size() <= 80
          && request.resource.data.refundedAt == request.time
          && request.resource.data.hidden == true
          && request.resource.data.hiddenBy == request.auth.uid
          && request.resource.data.hiddenAt == request.time)
        || (member()
          && resource.data.status == 'valid'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','refundReason','refundedByUid','refundedBySeat','refundedByName','refundedAt'
          ])
          && request.resource.data.status == 'voided'
          && request.resource.data.refundedByUid == request.auth.uid
          && request.resource.data.refundedBySeat is int
          && request.resource.data.refundedBySeat == (superAdmin() ? 26 : get(accountPath()).data.seat)
          && request.resource.data.refundedByName is string
          && request.resource.data.refundedByName.size() > 0
          && request.resource.data.refundedByName.size() <= 80
          && request.resource.data.refundedAt == request.time
          && request.resource.data.refundReason is string
          && request.resource.data.refundReason.size() > 0
          && request.resource.data.refundReason.size() <= 150)
        || (superAdmin()
          && resource.data.status == 'voided'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hidden','hiddenBy','hiddenAt'
          ])
          && request.resource.data.hidden == true
          && request.resource.data.hiddenBy == request.auth.uid
          && request.resource.data.hiddenAt == request.time);
      allow delete: if false;
    }
    match /audit/{id} {
      allow read: if manager();
      allow create: if auditCheck()
        && request.resource.data.hidden == false
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 300;
      allow update: if superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hidden','hiddenBy','hiddenAt'
        ])
        && request.resource.data.hidden == true
        && request.resource.data.hiddenBy == request.auth.uid
        && request.resource.data.hiddenAt == request.time;
      allow delete: if false;
    }
  }
}
